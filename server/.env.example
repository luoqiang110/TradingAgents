# Backend runtime
SERVER_APP_NAME=TradingAgents Cloud API
SERVER_MAX_WORKERS=1
SERVER_CORS_ORIGINS=https://your-domain.com
TRADINGAGENTS_API_KEY=change-me

# Default analysis settings
LLM_PROVIDER=openai
QUICK_THINK_LLM=gpt-5.4-mini
DEEP_THINK_LLM=gpt-5.4
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# Provider keys. Fill only the providers you use.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Nginx / Let's Encrypt
NGINX_SERVER_NAME=your-domain.com
CERTBOT_DOMAIN=your-domain.com
CERTBOT_EMAIL=admin@your-domain.com
NGINX_TEMPLATE=https.conf.template

